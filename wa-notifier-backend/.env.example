# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/wa_notifier
# If running with Docker Compose use:
# MONGODB_URI=mongodb://admin:changeme@mongo:27017/wa_notifier?authSource=admin

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Meta / WhatsApp Cloud API ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=wa_notifier_verify
META_API_VERSION=v25.0

# Tech Provider Embedded Signup.
# Direct Embedded Signup should keep META_WABA_ACCESS_MODE=embedded_signup.
# Only use provider_assignment/multi_partner when a BSP or Meta solution flow
# requires assigning a provider system user to client WABAs.
META_WABA_ACCESS_MODE=embedded_signup
META_ENABLE_PROVIDER_ASSIGNMENT=false

# Which token the backend should use for operational WhatsApp API calls
# such as sending messages, syncing/creating templates, registering numbers,
# and marking inbound messages as read.
# account  = use the token saved from Embedded Signup for each WABA.
# provider = use META_PROVIDER_SYSTEM_USER_ACCESS_TOKEN. Use this for
#            provider-style platforms after assigning the provider system user
#            to customer WABAs with messaging/template/phone access.
META_OPERATIONAL_ACCESS_TOKEN_SOURCE=account

# Advanced provider-assignment setup.
# META_PROVIDER_BUSINESS_ID lets the backend verify the system-user ID returned
# by https://graph.facebook.com/v25.0/{business-id}/system_users.
META_PROVIDER_BUSINESS_ID=
META_PROVIDER_SYSTEM_USER_ID=
META_PROVIDER_SYSTEM_USER_ACCESS_TOKEN=
META_WABA_SYSTEM_USER_TASKS=MANAGE

# Optional: set these when clients should send through your technical
# provider credit line instead of adding their own Meta payment method.
# When META_CREDIT_LINE_ID is present, onboarding/register/subscribe flows fail
# if the backend cannot attach this provider credit line to the client WABA.
META_CREDIT_LINE_ID=
META_WABA_CURRENCY=INR

# Public WhatsApp onboarding link token
CLIENT_ONBOARDING_TOKEN=change_this_public_connect_token

# ── Server ────────────────────────────────────────────────────
API_PORT=3001

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the same secret configured in the Razorpay Dashboard webhook
RAZORPAY_WEBHOOK_SECRET=

# ── CORS — set to your frontend URL ──────────────────────────
CORS_ORIGIN=http://localhost:3000, https://your-frontend-domain.com
