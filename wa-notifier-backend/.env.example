# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/wa_notifier
# If running with Docker Compose use:
# MONGODB_URI=mongodb://admin:changeme@mongo:27017/wa_notifier?authSource=admin

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Meta / WhatsApp Cloud API ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=wa_notifier_verify
META_API_VERSION=v25.0

# Public WhatsApp onboarding link token
CLIENT_ONBOARDING_TOKEN=change_this_public_connect_token

# ── Server ────────────────────────────────────────────────────
API_PORT=3001

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the same secret configured in the Razorpay Dashboard webhook
RAZORPAY_WEBHOOK_SECRET=

# ── CORS — set to your frontend URL ──────────────────────────
CORS_ORIGIN=http://localhost:3000,https://your-frontend-domain.com
