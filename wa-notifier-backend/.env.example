# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/wa_notifier
# If running with Docker Compose use:
# MONGODB_URI=mongodb://admin:changeme@mongo:27017/wa_notifier?authSource=admin

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Meta / WhatsApp Cloud API ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=wa_notifier_verify
META_API_VERSION=v25.0

# Tech Provider Embedded Signup.
# Create an admin system user in your provider business, give it access to this
# Meta app, then use these values so onboarded client WABAs are assigned to it.
# META_PROVIDER_BUSINESS_ID lets the backend verify the system-user ID returned
# by https://graph.facebook.com/v25.0/{business-id}/system_users.
META_PROVIDER_BUSINESS_ID=
META_PROVIDER_SYSTEM_USER_ID=
META_PROVIDER_SYSTEM_USER_ACCESS_TOKEN=
META_WABA_SYSTEM_USER_TASKS=MANAGE

# Optional: only set these if clients use your provider credit line instead of
# paying Meta directly from their own business payment method.
META_CREDIT_LINE_ID=
META_WABA_CURRENCY=INR

# Public WhatsApp onboarding link token
CLIENT_ONBOARDING_TOKEN=change_this_public_connect_token

# ── Server ────────────────────────────────────────────────────
API_PORT=3001

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the same secret configured in the Razorpay Dashboard webhook
RAZORPAY_WEBHOOK_SECRET=

# ── CORS — set to your frontend URL ──────────────────────────
CORS_ORIGIN=http://localhost:3000, https://your-frontend-domain.com
