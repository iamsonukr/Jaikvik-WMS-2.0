<mxfile host="app.diagrams.net" modified="2026-07-02T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="project-architecture" name="Project Architecture and Data Flow">
    <mxGraphModel dx="2200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="WhatsApp Management System - Detailed Project Flowchart&#10;Next.js frontend + NestJS API + MongoDB + Meta WhatsApp Cloud API" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="390" y="20" width="1580" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="Legend&#10;Solid arrow = normal request/data flow&#10;Dashed arrow = webhook/status callback or background effect&#10;Blue = frontend, green = API/modules, orange = data/schema, purple = external services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1660" y="100" width="360" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="frontendGroup" value="Frontend - wa-notifier-frontend" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=34;fillColor=#dbeafe;strokeColor=#2563eb;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="510" height="700" as="geometry"/>
        </mxCell>

        <mxCell id="fePages" value="Next.js 14 App Router Pages&#10;/login&#10;/dashboard&#10;/broadcasts, /broadcasts/new, /broadcasts/[id]&#10;/inbox&#10;/contacts&#10;/templates&#10;/chatbot&#10;/analytics&#10;/clients, /clients/[id]&#10;/settings&#10;/ page redirects into app flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;align=left;spacing=10;fontSize=12;" vertex="1" parent="frontendGroup">
          <mxGeometry x="20" y="55" width="220" height="255" as="geometry"/>
        </mxCell>

        <mxCell id="feShell" value="App Shell and Navigation&#10;layout.jsx wraps providers&#10;AppShell controls protected layout&#10;Sidebar routes: Dashboard, Broadcasts, Inbox, Contacts, Templates, Chatbot, Analytics, Clients, Settings&#10;lucide-react icons + UI components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;align=left;spacing=10;fontSize=12;" vertex="1" parent="frontendGroup">
          <mxGeometry x="260" y="55" width="220" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="feAuth" value="AuthProvider&#10;Loads wa_token from localStorage&#10;GET /auth/me restores session&#10;POST /auth/login stores JWT&#10;logout clears token and redirects /login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;align=left;spacing=10;fontSize=12;" vertex="1" parent="frontendGroup">
          <mxGeometry x="260" y="270" width="220" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="feClient" value="ClientProvider / useClient&#10;GET /clients after login&#10;Stores active client in wa_active_client&#10;Client switcher scopes Contacts, Templates, Inbox, Broadcasts, Chatbot and Analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;align=left;spacing=10;fontSize=12;" vertex="1" parent="frontendGroup">
          <mxGeometry x="20" y="335" width="220" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="feApi" value="lib/api.js - Axios Client&#10;baseURL = NEXT_PUBLIC_API_URL or http://localhost:3001/api&#10;Adds Authorization: Bearer wa_token&#10;401 handler removes token and redirects to /login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfdbfe;strokeColor=#2563eb;align=left;spacing=10;fontSize=12;fontStyle=1;" vertex="1" parent="frontendGroup">
          <mxGeometry x="145" y="520" width="230" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="backendGroup" value="Backend API - wa-notifier-backend" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=34;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="650" y="120" width="770" height="700" as="geometry"/>
        </mxCell>

        <mxCell id="nestCore" value="NestJS Core&#10;AppModule imports Config, Mongoose, Schedule, Auth, Clients, Contacts, Templates, Broadcasts, Inbox, Chatbot, Analytics, Webhooks&#10;Global /api prefix&#10;Swagger at /api/docs&#10;CORS from CORS_ORIGIN&#10;ValidationPipe whitelist + transform&#10;Global JwtAuthGuard; @Public bypasses auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;align=left;spacing=10;fontSize=12;" vertex="1" parent="backendGroup">
          <mxGeometry x="20" y="55" width="230" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="authModule" value="Auth Module&#10;POST /auth/register public&#10;POST /auth/login public&#10;GET /auth/me&#10;PATCH /auth/me&#10;PATCH /auth/password&#10;bcrypt password hashing&#10;JWT payload: sub, email, role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;align=left;spacing=10;fontSize=12;" vertex="1" parent="backendGroup">
          <mxGeometry x="280" y="55" width="210" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="clientsModule" value="Clients Module&#10;GET /clients&#10;GET /clients/:id&#10;POST /clients&#10;PATCH /clients/:id&#10;DELETE /clients/:id&#10;Access tokens hidden in public list/detail responses&#10;Find by phoneNumberId for webhook routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;align=left;spacing=10;fontSize=12;" vertex="1" parent="backendGroup">
          <mxGeometry x="520" y="55" width="210" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="contactsModule" value="Contacts Module&#10;GET /contacts?clientId&amp;tag&#10;GET /contacts/tags&#10;GET /contacts/count&#10;POST /contacts&#10;POST /contacts/bulk&#10;PATCH /contacts/:id&#10;DELETE /contacts/:id&#10;Segments by tags, active and opted-out filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;align=left;spacing=10;fontSize=12;" vertex="1" parent="backendGroup">
          <mxGeometry x="20" y="330" width="230" height="225" as="geometry"/>
        </mxCell>

        <mxCell id="templatesModule" value="Templates Module&#10;GET /templates?clientId&#10;POST /templates/sync/:clientId&#10;Calls Meta message_templates endpoint&#10;Bulk upserts template metadata, status, category, language and components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;align=left;spacing=10;fontSize=12;" vertex="1" parent="backendGroup">
          <mxGeometry x="280" y="290" width="210" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="broadcastsModule" value="Broadcasts Module&#10;GET /broadcasts?clientId&#10;GET /broadcasts/:id&#10;GET /broadcasts/:id/logs&#10;POST /broadcasts&#10;PATCH /broadcasts/:id&#10;POST /broadcasts/:id/send&#10;Fire-and-forget send job&#10;Batches 10 messages then waits 1s&#10;Personalizes component text variables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;align=left;spacing=10;fontSize=12;" vertex="1" parent="backendGroup">
          <mxGeometry x="520" y="290" width="210" height="245" as="geometry"/>
        </mxCell>

        <mxCell id="inboxModule" value="Inbox Module&#10;GET /inbox/threads&#10;GET /inbox/messages&#10;POST /inbox/reply&#10;POST /inbox/assign/:id&#10;POST /inbox/resolve&#10;Aggregates latest thread per phone&#10;Stores inbound and outbound messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;align=left;spacing=10;fontSize=12;" vertex="1" parent="backendGroup">
          <mxGeometry x="20" y="575" width="230" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="chatbotModule" value="Chatbot Module&#10;GET /chatbot?clientId&#10;POST /chatbot&#10;PATCH /chatbot/:id&#10;DELETE /chatbot/:id&#10;Match types: contains, exact, starts_with&#10;Priority ordered active rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;align=left;spacing=10;fontSize=12;" vertex="1" parent="backendGroup">
          <mxGeometry x="280" y="485" width="210" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="analyticsModule" value="Analytics Module&#10;GET /analytics/overview&#10;GET /analytics/daily?days=30&#10;GET /analytics/inbox&#10;Counts contacts, broadcasts, sent, delivered, read, failed, inbound, outbound and open threads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;align=left;spacing=10;fontSize=12;" vertex="1" parent="backendGroup">
          <mxGeometry x="520" y="565" width="210" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="webhooksModule" value="Webhooks Module&#10;GET /webhooks/meta public&#10;Meta verification using META_VERIFY_TOKEN&#10;POST /webhooks/meta public&#10;Processes statuses and inbound messages&#10;Client lookup cached by phoneNumberId&#10;Marks messages read&#10;Runs chatbot auto-reply for text messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;align=left;spacing=10;fontSize=12;fontStyle=1;" vertex="1" parent="backendGroup">
          <mxGeometry x="280" y="675" width="450" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="externalGroup" value="External Services and Runtime" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=34;fillColor=#ede9fe;strokeColor=#7c3aed;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1500" y="260" width="580" height="560" as="geometry"/>
        </mxCell>

        <mxCell id="metaService" value="MetaService Wrapper&#10;META_API_VERSION defaults to v19.0&#10;sendTemplate(phoneNumberId, token, to, templateName, languageCode, components)&#10;sendText(phoneNumberId, token, to, body)&#10;getTemplates(wabaId, token)&#10;markRead(phoneNumberId, token, messageId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;align=left;spacing=10;fontSize=12;" vertex="1" parent="externalGroup">
          <mxGeometry x="25" y="60" width="255" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="metaApi" value="Meta Graph / WhatsApp Cloud API&#10;/{phoneNumberId}/messages&#10;/{wabaId}/message_templates&#10;Sends template campaigns&#10;Sends text replies&#10;Returns message IDs&#10;Calls configured webhook with statuses and inbound messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#7c3aed;align=left;spacing=10;fontSize=12;fontStyle=1;" vertex="1" parent="externalGroup">
          <mxGeometry x="310" y="60" width="240" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="envRuntime" value="Environment / Runtime Config&#10;Backend: MONGODB_URI, API_PORT, CORS_ORIGIN, JWT_SECRET, META_VERIFY_TOKEN, META_API_VERSION&#10;Frontend: NEXT_PUBLIC_API_URL&#10;Dockerfiles for frontend and backend&#10;docker-compose files included" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;align=left;spacing=10;fontSize=12;" vertex="1" parent="externalGroup">
          <mxGeometry x="25" y="315" width="255" height="175" as="geometry"/>
        </mxCell>

        <mxCell id="recipient" value="WhatsApp Recipient&#10;Receives campaign templates and manual/chatbot replies&#10;Replies create inbound webhook events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;align=left;spacing=10;fontSize=12;" vertex="1" parent="externalGroup">
          <mxGeometry x="310" y="335" width="240" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="databaseGroup" value="MongoDB Data Model - Mongoose Schemas" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=34;fillColor=#ffedd5;strokeColor=#f97316;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="2020" height="850" as="geometry"/>
        </mxCell>

        <mxCell id="schemaUser" value="User&#10;email: string, required, unique, lowercase&#10;password: string, required, bcrypt pre-save hash&#10;role: string, default agent, admin or agent&#10;isActive: boolean, default true&#10;name: string&#10;timestamps: createdAt, updatedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="25" y="60" width="260" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="schemaClient" value="Client&#10;name: string, required&#10;wabaId: string, required&#10;phoneNumberId: string, required&#10;accessToken: string, required, hidden in public responses&#10;phone: display number&#10;isActive: boolean, default true&#10;timezone, industry: string&#10;index: phoneNumberId unique" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="315" y="60" width="280" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="schemaContact" value="Contact&#10;clientId: ObjectId ref Client, required&#10;phone: string, required, E.164 expected&#10;name: string&#10;tags: string[]&#10;variables: object for template personalization&#10;isActive: boolean, default true&#10;isOptedOut: boolean, default false&#10;index: clientId + phone unique" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="625" y="60" width="280" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="schemaTemplate" value="Template&#10;clientId: ObjectId ref Client, required&#10;name: string, required&#10;category: string&#10;language: string&#10;status: APPROVED, PENDING, REJECTED, etc.&#10;rawMeta: object from Meta&#10;components: object[]&#10;index: clientId + name unique" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="935" y="60" width="280" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="schemaBroadcast" value="Broadcast&#10;clientId: ObjectId ref Client, required&#10;name, templateName, languageCode: required&#10;components: object[]&#10;targetTags: string[], empty means all active opted-in contacts&#10;status: draft, queued, running, done, failed&#10;scheduledAt: Date&#10;totalCount, sentCount, deliveredCount, readCount, failedCount: number&#10;index: clientId + createdAt desc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="1245" y="60" width="335" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="schemaBroadcastLog" value="BroadcastLog&#10;broadcastId: ObjectId ref Broadcast, required&#10;clientId: ObjectId ref Client, required&#10;phone: string, required&#10;contactName: string&#10;waMessageId: string from Meta&#10;status: queued, sent, delivered, read, failed&#10;errorCode, errorMessage: string&#10;indexes: broadcastId, waMessageId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="1610" y="60" width="345" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="schemaMessage" value="Message&#10;clientId: ObjectId ref Client, required&#10;phone: string, required&#10;contactName: string&#10;direction: inbound or outbound, required&#10;type: text, image, audio, video, document, template&#10;text: string&#10;media: object&#10;waMessageId: string&#10;threadStatus: open, assigned, resolved&#10;assignedTo: ObjectId ref User&#10;timestamp: Date&#10;index: clientId + phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="315" y="365" width="315" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="schemaChatbot" value="ChatbotRule&#10;clientId: ObjectId ref Client, required&#10;keyword: string, required&#10;matchType: contains, exact, starts_with; default contains&#10;replyText: string, required&#10;isActive: boolean, default true&#10;priority: number, default 0&#10;index: clientId + priority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="665" y="365" width="295" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="schemaRelations" value="Relationships and Query Patterns&#10;Client owns Contacts, Templates, Broadcasts, Messages and ChatbotRules&#10;Broadcast creates many BroadcastLogs&#10;Messages can be assigned to User&#10;Webhook routes inbound events by Client.phoneNumberId&#10;Analytics reads Broadcast, Message and Contact collections&#10;Contacts segmentation uses tags + isActive + isOptedOut&#10;Template variables are resolved from Contact.variables before send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#f97316;align=left;spacing=10;fontSize=12;fontStyle=1;" vertex="1" parent="databaseGroup">
          <mxGeometry x="1020" y="365" width="420" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="flowBroadcast" value="Broadcast Send Flow&#10;1. User creates or edits broadcast&#10;2. POST /broadcasts/:id/send starts background job&#10;3. Load Client credentials and target Contacts by tags&#10;4. Insert BroadcastLog queued rows&#10;5. Send template messages through Meta in 10 msg batches with 1s delay&#10;6. Store waMessageId and sent/failed log status&#10;7. Meta status webhooks update logs and delivered/read counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="1480" y="365" width="475" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="flowInbound" value="Inbound Conversation Flow&#10;1. Recipient sends WhatsApp message&#10;2. Meta POSTs /webhooks/meta&#10;3. Backend finds Client by phoneNumberId&#10;4. Inbox saves Message as inbound/open&#10;5. Backend marks Meta message as read&#10;6. If text matches active ChatbotRule, Inbox.reply sends text via Meta&#10;7. Outbound reply is stored as Message&#10;8. Agents can reply, assign or resolve thread from Inbox UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="25" y="365" width="260" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="flowTemplateContact" value="Setup and Content Flow&#10;Client setup stores WABA ID, phoneNumberId and permanent access token&#10;Template sync imports Meta templates into MongoDB&#10;Contact creation and bulk import upsert contacts by clientId + phone&#10;Broadcasts target all opted-in contacts or contacts matching selected tags&#10;Analytics dashboards aggregate stored operational data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;align=left;spacing=10;fontSize=12;" vertex="1" parent="databaseGroup">
          <mxGeometry x="1020" y="635" width="420" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="e_fe_api" edge="1" parent="1" source="feApi" target="nestCore" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#2563eb;" value="HTTPS REST /api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_auth_login" edge="1" parent="1" source="feAuth" target="authModule" style="endArrow=block;html=1;rounded=0;strokeColor=#2563eb;" value="login/me/profile/password">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_client" edge="1" parent="1" source="feClient" target="clientsModule" style="endArrow=block;html=1;rounded=0;strokeColor=#2563eb;" value="active client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_pages_modules" edge="1" parent="1" source="fePages" target="broadcastsModule" style="endArrow=block;html=1;rounded=0;strokeColor=#2563eb;" value="feature pages call modules">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_modules_meta" edge="1" parent="1" source="broadcastsModule" target="metaService" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#16a34a;" value="sendTemplate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_templates_meta" edge="1" parent="1" source="templatesModule" target="metaService" style="endArrow=block;html=1;rounded=0;strokeColor=#16a34a;" value="getTemplates">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_inbox_meta" edge="1" parent="1" source="inboxModule" target="metaService" style="endArrow=block;html=1;rounded=0;strokeColor=#16a34a;" value="sendText">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_webhook_meta" edge="1" parent="1" source="webhooksModule" target="metaService" style="endArrow=block;html=1;rounded=0;strokeColor=#16a34a;" value="markRead">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_meta_service_api" edge="1" parent="1" source="metaService" target="metaApi" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#7c3aed;" value="Graph API">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_meta_recipient" edge="1" parent="1" source="metaApi" target="recipient" style="endArrow=block;html=1;rounded=0;strokeColor=#7c3aed;" value="messages">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_recipient_meta" edge="1" parent="1" source="recipient" target="metaApi" style="endArrow=block;html=1;rounded=0;strokeColor=#7c3aed;dashed=1;" value="replies">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_meta_webhook" edge="1" parent="1" source="metaApi" target="webhooksModule" style="endArrow=block;html=1;rounded=0;strokeColor=#7c3aed;dashed=1;strokeWidth=2;" value="webhook statuses and messages">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e_auth_user" edge="1" parent="1" source="authModule" target="schemaUser" style="endArrow=block;html=1;rounded=0;strokeColor=#f97316;" value="users">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_clients_schema" edge="1" parent="1" source="clientsModule" target="schemaClient" style="endArrow=block;html=1;rounded=0;strokeColor=#f97316;" value="clients">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_contacts_schema" edge="1" parent="1" source="contactsModule" target="schemaContact" style="endArrow=block;html=1;rounded=0;strokeColor=#f97316;" value="contacts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_templates_schema" edge="1" parent="1" source="templatesModule" target="schemaTemplate" style="endArrow=block;html=1;rounded=0;strokeColor=#f97316;" value="templates">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_broadcast_schema" edge="1" parent="1" source="broadcastsModule" target="schemaBroadcast" style="endArrow=block;html=1;rounded=0;strokeColor=#f97316;" value="broadcasts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_broadcast_log_schema" edge="1" parent="1" source="broadcastsModule" target="schemaBroadcastLog" style="endArrow=block;html=1;rounded=0;strokeColor=#f97316;" value="logs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_inbox_schema" edge="1" parent="1" source="inboxModule" target="schemaMessage" style="endArrow=block;html=1;rounded=0;strokeColor=#f97316;" value="messages">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_chatbot_schema" edge="1" parent="1" source="chatbotModule" target="schemaChatbot" style="endArrow=block;html=1;rounded=0;strokeColor=#f97316;" value="rules">
